// Haskell subset grammar for HaskOpt
// Supports: function definitions, type signatures, if-then-else,
// arithmetic, comparison, boolean ops, function application, pattern matching

?start: program

program: (_NL* declaration _NL*)*

?declaration: type_signature
            | function_def

// Type signature: foo :: Int -> Int -> Bool
type_signature: IDENT "::" type_expr

?type_expr: type_arrow

?type_arrow: type_atom ("->" type_arrow)  -> type_arrow
           | type_atom

?type_atom: "Int"     -> type_int
          | "Bool"    -> type_bool
          | "Float"   -> type_float
          | "String"  -> type_string
          | "(" type_expr ")"

// Function definition: foo x y = expr
function_def: IDENT params* "=" expr

params: IDENT

// Expressions - precedence from lowest to highest
?expr: if_expr
     | let_expr
     | or_expr

if_expr: "if" expr "then" expr "else" expr

let_expr: "let" let_bindings "in" expr
let_bindings: let_binding (";" let_binding)*
let_binding: IDENT "=" expr

?or_expr: or_expr "||" and_expr   -> bool_or
        | and_expr

?and_expr: and_expr "&&" comp_expr  -> bool_and
         | comp_expr

?comp_expr: add_expr "==" add_expr  -> eq
          | add_expr "/=" add_expr  -> neq
          | add_expr "<"  add_expr  -> lt
          | add_expr "<=" add_expr  -> lte
          | add_expr ">"  add_expr  -> gt
          | add_expr ">=" add_expr  -> gte
          | add_expr

?add_expr: add_expr "+" mul_expr   -> add
         | add_expr "-" mul_expr   -> sub
         | mul_expr

?mul_expr: mul_expr "*" unary_expr -> mul
         | mul_expr "/" unary_expr -> div_op
         | mul_expr "`mod`" unary_expr -> mod_op
         | unary_expr

?unary_expr: "not" unary_expr     -> not_op
           | "-" unary_expr       -> negate
           | app_expr

// Function application: f x y  (left associative)
?app_expr: app_expr atom          -> func_app
         | atom

?atom: INT_LITERAL
     | FLOAT_LITERAL
     | BOOL_LITERAL
     | STRING_LITERAL
     | IDENT
     | "(" expr ")"              -> paren_expr

// Terminals
INT_LITERAL: /[0-9]+/
FLOAT_LITERAL: /[0-9]+\.[0-9]+/
BOOL_LITERAL: "True" | "False"
STRING_LITERAL: /\"[^\"]*\"/

IDENT: /[a-zA-Z_][a-zA-Z0-9_']*/

// Whitespace and comments
COMMENT: /--[^\n]*/
%ignore COMMENT
%ignore /[ \t\f]+/
_NL: /\r?\n/+
